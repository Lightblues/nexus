# macOS
.DS_Store

# Xcode
DerivedData/
*.xcodeproj/xcuserdata/
*.xcworkspace/xcuserdata/

# XcodeGen — Nexus.xcodeproj is regenerated from project.yml on each build.
Nexus.xcodeproj/

# Swift Package Manager
.swiftpm/
Package.resolved

# Build outputs
build/archive/
build/export/
build/dmg-stage/
*.app
*.dSYM
*.dSYM.zip
*.dmg
dist/

# build/ also holds tracked source assets (icon.png). The user's global
# gitignore excludes `build/` wholesale; re-include only the assets we ship,
# *not* the build subdirectories above (which must stay ignored).
!build/
!build/icon.png
