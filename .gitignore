.DS_Store

# Xcode
DerivedData/
*.xcodeproj/xcuserdata/
*.xcworkspace/xcuserdata/

# XcodeGen — Nexus.xcodeproj is regenerated from project.yml on each build.
Nexus.xcodeproj/

# Swift Package Manager
.swiftpm/
Package.resolved

# Build outputs
build/archive/
build/export/
build/dmg-stage/
*.app
*.dSYM
*.dSYM.zip
*.dmg
dist/

# build/ holds source assets (icon.png) that must stay tracked. The global
# gitignore excludes the directory wholesale; re-include it explicitly.
!build/
!build/*
