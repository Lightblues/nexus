[Unit]
Description=nexus server (sync, export)
After=network.target docker.service

[Service]
Type=simple
WorkingDirectory=/data/projects/app/nexus/services/server
EnvironmentFile=/data/projects/app/nexus/services/server/.env
ExecStart=/usr/local/bin/node src/main.ts
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
