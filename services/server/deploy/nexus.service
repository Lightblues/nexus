[Unit]
Description=nexus server (sync, export)
After=network.target docker.service

[Service]
Type=simple
WorkingDirectory=/data/projects/app/nexus/services/server
# Rendered from the secrets store: secrets render env services/nexus.env /etc/nexus/env
EnvironmentFile=/etc/nexus/env
ExecStart=/usr/local/bin/node src/main.ts
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
